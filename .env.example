# Server-side only (Vercel → Project → Settings → Environment Variables). Never prefix with VITE_.
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.8-flash, falls back to gemini-3.5-flash-lite on rate limits)
GEMINI_MODEL=
# Optional: route the brief and actions through your n8n workflows instead of calling Gemini directly
N8N_DIGEST_URL=
N8N_ACTION_URL=
