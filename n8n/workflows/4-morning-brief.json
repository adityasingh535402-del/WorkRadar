    {
      "id": "aeb85abc-49dc-51e6-a5f7-f69ca72c4270",
      "name": "Format for Slack",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// n8n Code node · \"Format for Slack\" (Run once for all items)\n// Turns the AI brief into a Slack message (mrkdwn). Also usable as an email body.\n\nconst res = $input.first().json;\nconst brief = res.brief || {};\nconst ingest = $('Get ranked items').first().json;\nconst byId = new Map((ingest.items || []).map((i) => [i.id, i]));\nconst roster = new Map((ingest.snapshot.team || []).map((p) => [p.id, p.name]));\nconst ref = (id) => (byId.get(id) ? `*${byId.get(id).ref}* ${byId.get(id).title}` : id);\n\nconst lines = [];\nlines.push(`*WorkRadar morning brief* for ${ingest.snapshot.manager.name}`);\nlines.push(brief.headline || '');\nlines.push('');\nlines.push('*Top work for today*');\n(brief.topWork || []).forEach((t, i) => lines.push(`${i + 1}. ${ref(t.itemId)}\\n    ${t.why}`));\nif ((brief.blocked || []).length) {\n  lines.push('');\n  lines.push(\"*Who's blocked*\");\n  brief.blocked.forEach((b) => lines.push(`• ${roster.get(b.personId) || b.personId}: ${b.blockedOn}${b.since ? ` (${b.since})` : ''}\\n    ${b.suggestion}`));\n}\nif ((brief.happened || []).length) {\n  lines.push('');\n  lines.push('*What happened*');\n  brief.happened.slice(0, 4).forEach((h) => lines.push(`• ${h.text}`));\n}\nlines.push('');\nlines.push(`_Generated by ${res.model || 'n8n'} at ${new Date().toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' })}_`);\n\nreturn [{ json: { text: lines.join('\\n'), brief } }];\n"
      }
    },
